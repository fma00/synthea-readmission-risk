# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/

# Virtual environments
.venv/
venv/
env/
env*/

# Environment variables / secrets
.env
.env.*

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/

# Type checkers / linters
.mypy_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# OS cruft
.DS_Store

# Editors
.vscode/
.idea/

# Downloaded third-party tooling (fetched by scripts/setup_synthea.sh, verified against a
# hardcoded checksum sourced from GitHub's Releases API — not committed)
tools/synthea/

# Data and model artifacts (large / generated — track via a data pipeline, not git)
data/
*.csv
*.parquet
models/
*.pkl
*.joblib
