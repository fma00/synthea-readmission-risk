# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/

# Virtual environments
.venv/
venv/
env/
env*/
# Extra venvs the Makefile creates and recreates (.venv-dataproc, .venv-lock312)
.venv-*/

# Environment variables / secrets
.env
.env.*
!.env.example

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/

# Type checkers / linters
.mypy_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# OS cruft
.DS_Store

# Editors
.vscode/
.idea/

# Downloaded third-party tooling (fetched by scripts/setup_synthea.sh, verified against a
# hardcoded checksum sourced from GitHub's Releases API — not committed)
tools/synthea/

# Data and model artifacts (large / generated — track via a data pipeline, not git)
# /data/ is anchored to the repo root like /models/ below: an unanchored `data/` would silently ignore any future
# src/readmission_risk/data/ package or tests/**/data/ fixture directory.
/data/
*.csv
*.parquet
/models/
*.pkl
*.joblib
# Model bundles (v2 slice 2): local until v2 slice 3 moves them to GCS. Anchored like /data/ and /models/: an unanchored
# `bundles/` would also ignore src/readmission_risk/bundles/ and tests/bundles/.
/bundles/

# MLflow local tracking store (SQLite DB + artifacts) -- anchored to the repo root, like /models/ above
# (an unanchored `models/` also matched src/readmission_risk/models/ and tests/models/).
# *.db also catches the stray ./mlflow.db that any unconfigured MLflow call creates in the cwd.
/mlflow/
/mlruns/
/mlartifacts/
*.db

# Review-only low-resolution PNG previews of the README figures (scripts/make_readme_assets.py); the SVGs next to them are the
# published artifacts and stay tracked.
/docs/img/preview/
# Scratch directory of an interrupted scripts/make_readme_assets.py run.
/docs/img/.tmp-*/

# Personal / local-only Claude Code state. Only .claude/commands/ (the /eg-* workflow) is tracked on purpose; everything
# else under .claude/ (settings.local.json, scheduled_tasks.*, worktrees/, agent-memory*, checkpoints/, ...) stays local.
# If shared project files (settings.json, agents/, skills/) are ever added, un-ignore them explicitly, e.g. `!.claude/skills/`.
.claude/*
!.claude/commands/

# GCP / Streamlit credentials (the roadmap adds a service account and Streamlit secrets). Never commit keys.
# Best-effort safety net for common file names, NOT a substitute for keeping key files outside this directory.
**/.streamlit/secrets.toml
*service[-_]account*.json
*serviceaccount*.json
gha-creds-*.json
*-adminsdk-*.json
key.json
keyfile.json
token.json
secrets.toml
*.env
*-credentials.json
credentials.json
application_default_credentials.json
client_secret*.json
*-key.json
# Google's default name for a downloaded service-account key: <project-id>-<12 hex characters>.json
*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].json
*.pem
*.key
*.p12
*.pfx
